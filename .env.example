# Copia este archivo a .env.local (o pon estas variables en Netlify → Site configuration →
# Environment variables). Nunca subas llaves a git ni las pegues en un chat.

# --- IA (obligatoria) ---
# Anthropic: lee la transcripción, encuentra lo importante y escribe la narración.
ANTHROPIC_API_KEY=

# --- Transcripción (una de las dos) ---
# Groq es la más barata (~$0.04 USD por hora de video). console.groq.com → API Keys
GROQ_API_KEY=
# OpenAI también sirve para transcribir si no pones Groq, y es la que da la VOZ del narrador.
# platform.openai.com → API keys. Sin ella el narrador sale en texto.
OPENAI_API_KEY=

# --- Base de datos (obligatoria en producción) ---
# Upstash Redis (plan gratis): cuentas, minutos y pagos. console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pagos (Stripe) ---
# dashboard.stripe.com → Developers → API keys → Secret key (sk_live_… o sk_test_… para probar)
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint https://TU-SITIO/api/pagos/webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# --- Seguridad ---
# Cualquier texto largo y aleatorio. Firma los trabajos de resumen.
HOOKLY_SECRET=

# --- Opcionales ---
# Dirección pública del sitio (Netlify la pone sola en URL).
NEXT_PUBLIC_SITE_URL=
# Modelos y servidores alternativos (compatibles con la API de OpenAI).
GROQ_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
GROQ_BASE_URL=
OPENAI_BASE_URL=
# Solo desarrollo: 1 desactiva el límite diario de hooks.
HOOKLY_SIN_LIMITE=
