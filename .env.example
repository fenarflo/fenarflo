# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a git.

# Obligatoria: API key de Anthropic (solo la usa la función /api/generar en el servidor)
ANTHROPIC_API_KEY=

# Recomendado en producción: Upstash Redis (plan gratis) para el límite de 3 generaciones al día.
# Si usas la integración de Upstash en Vercel, también funcionan KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional (solo desarrollo): 1 desactiva el límite diario en el servidor.
HOOKLY_SIN_LIMITE=

# Opcional: 1 muestra el interruptor "Simular Pro" en /precios fuera de desarrollo (demos).
NEXT_PUBLIC_PRO_DEMO=
